# embed_help.cmake -- help/*.md -> one .cpp of raw strings (s024 m6).
#   cmake -DSRC=<help> -DOUT=<file.cpp> -P embed_help.cmake
# The user guide is ONE source: the repo's help/ (readable on GitHub), compiled
# into the core so the designer's Help window and `mortimer-gen help` show the
# same pages. A page containing the raw-string delimiter fails the build, loudly.
file(GLOB files RELATIVE "${SRC}" "${SRC}/*.md")
list(SORT files)
set(body "// GENERATED by embed_help.cmake from help/ -- DO NOT EDIT.\n#include \"core/Help.hpp\"\n\nnamespace mortimer::core {\n\nconst std::vector<HelpPage>& embedded_help_pages() {\n    static const std::vector<HelpPage> p = {\n")
foreach(f IN LISTS files)
    file(READ "${SRC}/${f}" content)
    string(FIND "${content}" ")MORTIMER_H\"" bad)
    if(NOT bad EQUAL -1)
        message(FATAL_ERROR "help page ${f} contains the raw-string delimiter")
    endif()
    string(APPEND body "        {\"${f}\", R\"MORTIMER_H(${content})MORTIMER_H\"},\n")
endforeach()
string(APPEND body "    };\n    return p;\n}\n\n}  // namespace mortimer::core\n")
file(WRITE "${OUT}.tmp" "${body}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
