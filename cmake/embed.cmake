# embed.cmake -- templates/project/** -> one .cpp of raw string literals.
#   cmake -DSRC=<templates/project> -DOUT=<file.cpp> -P embed.cmake
# Each file becomes R"MORTIMER_T(...)MORTIMER_T" -- a template that contains
# that delimiter would break the build, loudly, which is the right failure.
file(GLOB_RECURSE files RELATIVE "${SRC}" "${SRC}/*")
list(SORT files)
set(body "// GENERATED by embed.cmake from templates/project -- DO NOT EDIT.\n#include \"core/Templates.hpp\"\n\nnamespace mortimer::core {\n\nconst std::vector<TemplateFile>& project_templates() {\n    static const std::vector<TemplateFile> t = {\n")
foreach(f IN LISTS files)
    file(READ "${SRC}/${f}" content)
    string(FIND "${content}" ")MORTIMER_T\"" bad)
    if(NOT bad EQUAL -1)
        message(FATAL_ERROR "template ${f} contains the raw-string delimiter")
    endif()
    string(APPEND body "        {\"${f}\", R\"MORTIMER_T(${content})MORTIMER_T\"},\n")
endforeach()
string(APPEND body "    };\n    return t;\n}\n\n}  // namespace mortimer::core\n")
file(WRITE "${OUT}.tmp" "${body}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
